# KoreX Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env with real secrets.

# ---- Database ----
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://korex:changeme@localhost:5432/korex
REDIS_URL=redis://localhost:6379/0

# ---- Object Storage (MinIO / S3-compatible) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ---- Notion Integration ----
NOTION_API_TOKEN=your_notion_api_token_here
NOTION_WEBHOOK_SECRET=your_notion_webhook_secret_here

# ---- LLM / AI ----
LLM_API_KEY=your_llm_api_key_here
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=korex-dev

# ---- Auth / Security ----
JWT_SECRET_KEY=generate_a_secure_random_string_here
OIDC_ISSUER_URL=https://your-idp.example.com
OIDC_CLIENT_ID=your_oidc_client_id_here
OIDC_CLIENT_SECRET=your_oidc_client_secret_here

# ---- External APIs ----
WEATHER_API_KEY=your_weather_api_key_here
TRANSPORT_API_KEY=your_transport_api_key_here

# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
